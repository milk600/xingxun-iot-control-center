<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/rootContainer"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:ignore="MergeRootFrame">

    <WebView
        android:id="@+id/webView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:alpha="0"
        android:background="@color/app_background"
        android:overScrollMode="never" />

    <FrameLayout
        android:id="@+id/connectionPanel"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/app_background"
        android:clickable="true"
        android:focusable="true"
        android:paddingStart="@dimen/connection_horizontal_margin"
        android:paddingEnd="@dimen/connection_horizontal_margin">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:background="@drawable/panel_background"
            android:elevation="8dp"
            android:orientation="vertical"
            android:padding="24dp">

            <ImageView
                android:layout_width="52dp"
                android:layout_height="52dp"
                android:contentDescription="@string/app_name"
                android:src="@drawable/ic_launcher" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:fontFamily="sans-serif-medium"
                android:text="@string/offline_title"
                android:textColor="@color/app_ink"
                android:textSize="22sp" />

            <TextView
                android:id="@+id/connectionStatus"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:lineSpacingExtra="2dp"
                android:text="@string/offline_loading"
                android:textColor="@color/app_muted"
                android:textSize="14sp" />

            <Button
                android:id="@+id/retryButton"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="20dp"
                android:background="@drawable/button_primary"
                android:fontFamily="sans-serif-medium"
                android:minHeight="48dp"
                android:stateListAnimator="@null"
                android:text="@string/retry"
                android:textAllCaps="false"
                android:textColor="@android:color/white"
                android:textSize="15sp"
                android:visibility="gone" />

            <Button
                android:id="@+id/cancelButton"
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:layout_marginTop="4dp"
                android:background="@drawable/button_secondary"
                android:fontFamily="sans-serif-medium"
                android:minHeight="44dp"
                android:stateListAnimator="@null"
                android:text="@string/exit_app"
                android:textAllCaps="false"
                android:textColor="@color/app_blue"
                android:textSize="14sp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:lineSpacingExtra="2dp"
                android:text="@string/offline_hint"
                android:textColor="@color/app_muted"
                android:textSize="12sp" />
        </LinearLayout>
    </FrameLayout>

</FrameLayout>
