# Copy this file to .env.local. Keep .env.local private.
# The defaults below run without cloud credentials or vehicle access.

# IoT data providers
IOT_PROVIDER=mock
IOT_SENSOR_PROVIDER=mock

# Huawei Cloud IoTDA (optional, server-side only)
HUAWEI_IOTDA_ENDPOINT=
HUAWEI_IOTDA_PROJECT_ID=
HUAWEI_IOTDA_PROJECT_NAME=cn-north-4
HUAWEI_IOTDA_REGION_ID=cn-north-4
HUAWEI_IOTDA_DEVICE_ID=
HUAWEI_IOTDA_SERVICE_ID=Environment
HUAWEI_IOTDA_INSTANCE_ID=
HUAWEI_IOTDA_STALE_AFTER_MS=30000
HUAWEI_IOTDA_OFFLINE_AFTER_MS=90000

# Preferred Huawei credential source: an ignored local CSV file.
HUAWEI_CREDENTIALS_FILE=
# Alternative server-side environment variables.
HUAWEICLOUD_SDK_AK=
HUAWEICLOUD_SDK_SK=
# Optional temporary token or least-privilege IAM user.
HUAWEI_IOTDA_TOKEN=
HUAWEI_IAM_ENDPOINT=https://iam.cn-north-4.myhuaweicloud.com
HUAWEI_IAM_ACCOUNT_NAME=
HUAWEI_IAM_USERNAME=
HUAWEI_IAM_PASSWORD=

# Legacy trusted gateway (optional)
HUAWEI_IOT_GATEWAY_URL=
HUAWEI_IOT_GATEWAY_TOKEN=

# DeepSeek and Alibaba Cloud Model Studio / Fun-ASR (optional)
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-flash
DEEPSEEK_REASONING_MODE=always
DEEPSEEK_ANALYSIS_MODEL=deepseek-v4-flash
DEEPSEEK_ANALYSIS_REASONING_EFFORT=high
DASHSCOPE_CREDENTIALS_FILE=
DASHSCOPE_API_KEY=
DASHSCOPE_WORKSPACE_ID=
FUN_ASR_MODEL=fun-asr-realtime
FUN_ASR_WS_URL=

# Agent gateway: safe local defaults
AI_GATEWAY_PORT=8766
AI_ALLOW_LOCAL_AUTO_PAIR=false
AI_MOCK_MODE=true
AI_VEHICLE_ENABLED=false
AI_FULL_ACCESS=false
IOT_WEB_BASE_URL=http://localhost:3000

# Jetson vehicle (configure explicitly before enabling)
JETSON_WS_URL=ws://127.0.0.1:8765

# Local telemetry history
TELEMETRY_HISTORY_DB=./data/telemetry-history.sqlite
TELEMETRY_RETENTION_DAYS=30
TELEMETRY_POLL_INTERVAL_MS=1000
TELEMETRY_REQUEST_TIMEOUT_MS=20000
TELEMETRY_SAMPLE_INTERVAL_MS=10000
