{
  "name": "xingxun-iot-control-center",
  "version": "2.7.0",
  "description": "面向危化场景研究与教学的 IoT 监控、数字孪生、AI 分析和巡检车控制中心。",
  "private": true,
  "license": "MIT",
  "author": "milk600 and contributors",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/milk600/xingxun-iot-control-center.git"
  },
  "homepage": "https://github.com/milk600/xingxun-iot-control-center#readme",
  "bugs": {
    "url": "https://github.com/milk600/xingxun-iot-control-center/issues"
  },
  "keywords": [
    "iot",
    "digital-twin",
    "react",
    "jetson",
    "stm32"
  ],
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "vinext dev",
    "dev:lan": "vinext dev -H 0.0.0.0",
    "build": "vinext build && node scripts/patch-vinext-standalone.mjs",
    "start": "vinext start",
    "agent:dev": "tsx agent/dev-runner.ts",
    "agent:start": "tsx agent/gateway.ts",
    "iotctl": "tsx agent/iotctl.ts",
    "iot:huawei:setup": "node --env-file=.env.local --import tsx scripts/setup-huawei-iotda.ts",
    "iot:huawei:inspect": "node --env-file=.env.local --import tsx scripts/inspect-huawei-iotda.ts",
    "iot:huawei:verify": "node --env-file=.env.local --import tsx scripts/verify-huawei-iotda.ts",
    "demo:assets": "node scripts/generate-demo-room.mjs",
    "model:top-view": "node --import tsx scripts/generate-room-top-view.ts",
    "auth:setup": "node scripts/setup-local-auth.mjs",
    "test:agent": "node scripts/run-agent-tests.mjs",
    "build:android-web": "vite build --config vite.offline.config.ts",
    "android:debug": "npm run build:android-web && android\\gradlew.bat -p android lintDebug assembleDebug",
    "android:release": "npm run build:android-web && android\\gradlew.bat -p android lintRelease assembleRelease",
    "android:share": "npm run android:release",
    "delivery:windows": "npm run build && npm run build:android-web && android\\gradlew.bat -p android --no-daemon --max-workers=1 assembleRelease && node scripts/package-windows-delivery.mjs",
    "test": "npm run build && node --import tsx --test tests/rendered-html.test.mjs",
    "lint": "eslint . --ignore-pattern dist --ignore-pattern .next --ignore-pattern .tools",
    "db:generate": "drizzle-kit generate"
  },
  "dependencies": {
    "@huaweicloud/huaweicloud-sdk-core": "^3.1.210",
    "@huaweicloud/huaweicloud-sdk-iotda": "^3.1.210",
    "@sparkjsdev/spark": "2.1.0",
    "drizzle-orm": "0.45.2",
    "echarts": "^6.1.0",
    "lucide-react": "^1.33.0",
    "next": "16.3.1",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "three": "0.185.1",
    "uuid": "^14.0.2",
    "ws": "^8.21.3"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.47.0",
    "@cloudflare/workers-types": "^5.20260724.1",
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@types/three": "0.185.1",
    "@types/ws": "^8.18.1",
    "@vitejs/plugin-react": "6.0.4",
    "@vitejs/plugin-rsc": "0.5.30",
    "drizzle-kit": "0.31.10",
    "eslint": "9.39.4",
    "eslint-config-next": "16.2.11",
    "react-server-dom-webpack": "19.2.8",
    "tailwindcss": "4.2.1",
    "tsx": "^4.23.1",
    "typescript": "5.9.3",
    "vinext": "0.0.50",
    "vite": "8.1.5",
    "wrangler": "4.114.0"
  },
  "overrides": {
    "fast-uri": "3.1.4",
    "js-yaml": "4.3.0",
    "minimatch@3.1.5": {
      "brace-expansion": "1.1.16"
    },
    "minimatch@10.2.5": {
      "brace-expansion": "5.0.8"
    },
    "postcss": "8.5.23",
    "sharp": "0.35.2",
    "@esbuild-kit/core-utils": {
      "esbuild": "0.25.12"
    }
  },
  "type": "module"
}
